---
import '../styles/site.css'
import LogoBlack from '../assets/brand/logo-horizontal-black.svg'
import LogoWhite from '../assets/brand/logo-horizontal-white.svg'
import { LOCALES, LOCALE_LABELS, LOCALE_SHORT, STRINGS, localePath, otherLocale, type Locale } from '../i18n'
import { setLanguageCookie } from '../lib/locale.mjs'
import { themeScript } from '../lib/theme.mjs'
import { motionScript } from '../lib/motion.mjs'

interface Props {
  locale: Locale
  /** The page's path without its language, e.g. `/download/`. */
  path: string
  title: string
  description?: string
}

const { locale, path, title, description = STRINGS[Astro.props.locale].description } = Astro.props
const t = STRINGS[locale]
const other = otherLocale(locale)
const absolute = (target: string) => new URL(target, Astro.site).href
const here = absolute(localePath(locale, path))
const pageTitle = title.includes('MailX') ? title : `${title} · MailX`
const nav = [
  { href: localePath(locale, '/'), label: t.nav.home, path: '/' },
  { href: localePath(locale, '/download/'), label: t.nav.download, path: '/download/' },
  { href: localePath(locale, '/docs/'), label: t.nav.docs, path: '/docs/' },
  { href: localePath(locale, '/changelog/'), label: t.nav.changelog, path: '/changelog/' },
]
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeScript} />
    <script is:inline set:html={motionScript} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={here} />
    {LOCALES.map((item) => <link rel="alternate" hreflang={item} href={absolute(localePath(item, path))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(path)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MailX" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={here} />
    <meta property="og:image" content={absolute('/og-image.png')} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline set:html={setLanguageCookie} />
  </head>
  <body>
    <header class="site-header wrap">
      <div class="bar glass">
        <a class="logo" href={localePath(locale, '/')} aria-label="MailX">
          <LogoBlack class="only-light" height={26} width={74} aria-hidden="true" />
          <LogoWhite class="only-dark" height={26} width={74} aria-hidden="true" />
        </a>
        <nav>
          {nav.map((item) => <a class:list={{ roomy: item.path === '/changelog/', home: item.path === '/' }} href={item.href} aria-current={item.path === path ? 'page' : undefined}>{item.label}</a>)}
          <a class="wide" href="https://github.com/GuqierMcl/MailX">{t.nav.github}</a>
          <a class="language" href={localePath(other, path)} hreflang={other} lang={other} aria-label={LOCALE_LABELS[other]}>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8" cy="8" r="6.3" /><path d="M1.8 8h12.4M8 1.7c1.7 1.7 2.6 3.8 2.6 6.3S9.7 12.6 8 14.3M8 1.7C6.3 3.4 5.4 5.5 5.4 8s.9 4.6 2.6 6.3" /></svg>
            <span>{LOCALE_SHORT[other]}</span>
          </a>
          <button class="theme-toggle" type="button" aria-label={t.nav.darkMode} title={t.nav.darkMode} aria-pressed="false" hidden>
            <svg class="only-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" /></svg>
            <svg class="only-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
          </button>
          <script is:inline>
            (() => {
              const button = document.querySelector('.theme-toggle')
              button.hidden = false
              button.addEventListener('click', () => window.mxTheme.toggle())
              window.mxTheme.apply()
            })()
          </script>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer wrap">
      <span>© MailX · {t.footer.license}</span>
      <a class="push" href={localePath(locale, '/changelog/')}>{t.nav.changelog}</a>
      <a href={localePath(locale, '/docs/privacy/')}>{t.footer.privacy}</a>
      <a href="https://github.com/GuqierMcl/MailX">GitHub</a>
    </footer>
  </body>
</html>
