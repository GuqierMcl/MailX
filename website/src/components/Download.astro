---
import Site from '../layouts/Site.astro'
import { STRINGS, type Locale } from '../i18n'
import { RELEASES_URL, formatSize, latestRelease, type Download, type DownloadId, type LinuxArchitecture } from '../lib/release'

interface Props { locale: Locale }
const { locale } = Astro.props
const t = STRINGS[locale].download
const release = await latestRelease()
const find = (id: DownloadId): Download | undefined => release?.downloads[id]
type Link = { id: string; label: string; download: Download | undefined }
type LinkGroup = { label?: string; links: Link[] }
const linuxArchitectures: LinuxArchitecture[] = ['x64', 'arm64']
const linuxFormats = ['appimage', 'deb', 'rpm'] as const
const hasLinuxArm64 = linuxFormats.some((format) => find(`linux-arm64-${format}`))
const groups: { os: string; name: string; note: string; extra: string | null; linkGroups: LinkGroup[] }[] = [
  { os: 'macos', name: t.macos.name, note: t.macos.note, extra: t.macos.which, linkGroups: [{ links: [
    { id: 'arm', label: t.macos.arm, download: find('macos-arm64') },
    { id: 'intel', label: t.macos.intel, download: find('macos-x64') },
  ] }] },
  { os: 'windows', name: t.windows.name, note: t.windows.note, extra: find('windows-arm64') ? t.windows.which : null, linkGroups: [{ links: [
    { id: 'windows-x64', label: t.windows.x64, download: find('windows-x64') },
    { id: 'windows-arm64', label: t.windows.arm64, download: find('windows-arm64') },
  ] }] },
  { os: 'linux', name: t.linux.name, note: hasLinuxArm64 ? `${t.linux.ubuntuMinimum} ${t.linux.note}` : t.linux.note, extra: null, linkGroups: linuxArchitectures.map((arch) => ({
    label: t.linux[arch],
    links: linuxFormats.map((format) => ({
      id: `${arch}-${format}`,
      label: t.linux[format],
      download: find(`linux-${arch}-${format}`),
    })),
  })) },
]
---

<Site locale={locale} path="/download/" title={t.title}>
  <div class="page-head wrap center">
    <h1 data-reveal>{t.title}</h1>
    <p data-reveal style="--i:1">{t.lead}</p>
    {release && <p class="version numeric" data-reveal style="--i:2">{t.version(release.version, release.date)} · <a href={release.url}>{t.releaseNotes}</a></p>}
  </div>
  <div class="wrap">
    {release ? (
      <div class="grid">
        <h2 class="others-title muted">{t.others}</h2>
        {groups.map((group, index) => (
          <section class="glass card" data-os={group.os} data-reveal style={`--i:${index + 3}`}>
            <p class="badge">{t.recommended}</p>
            <h2>{group.name}</h2>
            <p class="muted note">{group.note}</p>
            {group.linkGroups.map(({ label, links }) => links.some((link) => link.download) && (
              <div class="links">
                {label && <h3>{label}</h3>}
                {links.map((link) => link.download && (
                  <a class="button" data-link={link.id} href={link.download.url} aria-label={label ? `${link.label} (${label})` : undefined}>
                    {link.label}<span class="size numeric">{formatSize(link.download.size)}</span>
                  </a>
                ))}
              </div>
            ))}
            {group.extra && <p class="muted extra">{group.extra}</p>}
          </section>
        ))}
      </div>
    ) : (
      <section class="glass card fallback"><p>{t.fallback}</p><a class="button primary" href={`${RELEASES_URL}/latest`}>GitHub</a></section>
    )}
    <p class="muted more" data-reveal>
      {t.updates}{' '}
      <a href={RELEASES_URL}>{t.allReleases}</a>
      {release?.checksums && <Fragment> · <a href={release.checksums}>{t.checksums}</a></Fragment>}
    </p>
  </div>
</Site>

<script>
  // Without a match, or without scripts, the three systems stay side by side.
  const agent = navigator.userAgent
  const mobile = /Android|iPhone|iPad/.test(agent)
  const os = mobile ? null : /Windows/.test(agent) ? 'windows' : /Mac OS X/.test(agent) ? 'macos' : /Linux/.test(agent) ? 'linux' : null
  const grid = document.querySelector<HTMLElement>('.grid')
  const card = os && grid?.querySelector<HTMLElement>(`.card[data-os="${os}"]`)
  if (grid && card) {
    grid.dataset.os = os
    card.classList.add('featured')
    const primary = (id: string) => card.querySelector(`[data-link="${id}"]`)?.classList.add('primary')
    const hints = (navigator as Navigator & { userAgentData?: { getHighEntropyValues(keys: string[]): Promise<{ architecture?: string; bitness?: string }> } }).userAgentData
    if (os === 'windows') {
      // Chromium reports the CPU; elsewhere x64 is the likelier guess. Releases
      // without an ARM64 installer only show the x64 button.
      const windows = (arm: boolean) =>
        primary(arm && card.querySelector('[data-link="windows-arm64"]') ? 'windows-arm64' : 'windows-x64')
      hints?.getHighEntropyValues(['architecture'])
        .then((values) => windows(values.architecture === 'arm'))
        .catch(() => windows(false)) ?? windows(false)
    }
    if (os === 'linux') {
      // Reduced Linux user agents do not reliably identify the architecture.
      hints?.getHighEntropyValues(['architecture', 'bitness']).then(({ architecture, bitness }) => {
        if (bitness !== '64') return
        if (architecture === 'x86') primary('x64-appimage')
        if (architecture === 'arm') primary('arm64-appimage')
      }).catch(() => {})
    }
    if (os === 'macos') {
      // Chromium can tell the chip; elsewhere Apple silicon is the likelier guess.
      hints?.getHighEntropyValues(['architecture'])
        .then((values) => primary(values.architecture === 'x86' ? 'intel' : 'arm'))
        .catch(() => primary('arm')) ?? primary('arm')
    }
  }
</script>

<style>
  .center { text-align: center; }
  .center p { margin-inline: auto; }
  .version { font-size: 0.95rem; }
  .grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); align-items: start; }
  .others-title { display: none; grid-column: 1 / -1; margin: 2.5rem 0 0; font-size: 0.95rem; font-weight: 600; text-align: center; }
  .card { padding: 1.75rem; border-radius: var(--mx-radius); position: relative; }
  .card h2 { font-size: 1.35rem; }
  .card .note { margin: 0.6rem 0 0; font-size: 0.95rem; }
  .badge { display: none; margin: 0 0 0.6rem; font-size: 0.8rem; font-weight: 600; color: var(--mx-accent); }
  .links { display: grid; gap: 0.6rem; margin-top: 1.25rem; }
  .links h3 { margin: 0; font-size: 1rem; text-align: left; }
  .links .button { justify-content: space-between; }
  .size { font-weight: 400; font-size: 0.85rem; opacity: 0.7; }
  .extra { font-size: 0.85rem; margin: 1rem 0 0; }
  .more { margin: 2.5rem 0 0; font-size: 0.95rem; text-align: center; }
  .fallback { display: grid; gap: 1rem; justify-items: start; }

  /* The visitor's system: on top, centred, with its likely download as the main button. */
  .grid[data-os] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid[data-os] .others-title { display: block; }
  .card.featured {
    order: -1;
    grid-column: 1 / -1;
    justify-self: center;
    width: min(560px, 100%);
    padding: 2.25rem;
    text-align: center;
    box-shadow: inset 0 1px 0 var(--mx-glass-edge), 0 0 0 1.5px color-mix(in oklab, var(--mx-accent) 55%, transparent), var(--mx-shadow);
  }
  .featured .badge { display: block; }
  .featured h2 { font-size: 1.8rem; }
  .featured .links .button { min-height: 52px; font-size: 1.05rem; }
  @media (max-width: 720px) {
    .grid[data-os] { grid-template-columns: minmax(0, 1fr); }
  }
</style>
