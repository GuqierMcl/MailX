---
/**
 * Overrides Starlight's SiteTitle to inline the brand SVG directly in HTML,
 * avoiding external <img> reloads and decode flicker when switching chapters.
 */
import LogoBlack from '../assets/brand/logo-horizontal-black.svg'
import LogoWhite from '../assets/brand/logo-horizontal-white.svg'
import { LOCALES, localePath } from '../i18n'

const locale = LOCALES.find((item) => Astro.url.pathname.startsWith(`/${item}/`)) ?? LOCALES[0]
const siteTitleHref = localePath(locale, '/')
const siteTitle = locale === 'zh-CN' ? 'MailX 文档' : 'MailX Docs'
---

<a href={siteTitleHref} class="site-title sl-flex">
  <LogoWhite class="light:sl-hidden print:hidden" height={26} width={74} aria-hidden="true" />
  <LogoBlack class="dark:sl-hidden print:block" height={26} width={74} aria-hidden="true" />
  <span class="sr-only" translate="no">{siteTitle}</span>
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      gap: var(--sl-nav-gap);
      font-size: var(--sl-text-h4);
      font-weight: 600;
      color: var(--sl-color-text-accent);
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }
  }
</style>
