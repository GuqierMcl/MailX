---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

interface Props {
  light: ImageMetadata
  dark: ImageMetadata
  alt: string
  sizes: string
  eager?: boolean
}

// One <picture> with a media query, so a visitor downloads only the screenshot
// that matches their system theme.
const { light, dark, alt, sizes, eager = false } = Astro.props
const widths = [640, 960, 1280, 2000]
const [lightImage, darkImage] = await Promise.all([light, dark].map((src) => getImage({ src, format: 'webp', widths, sizes })))
---

<picture>
  <source media="(prefers-color-scheme: dark)" srcset={darkImage.srcSet.attribute} sizes={sizes} width={dark.width} height={dark.height} />
  <img
    src={lightImage.src}
    srcset={lightImage.srcSet.attribute}
    sizes={sizes}
    width={light.width}
    height={light.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
</picture>
