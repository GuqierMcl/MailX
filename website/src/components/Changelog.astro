---
import changelog from '../../../CHANGELOG.md?raw'
import Site from '../layouts/Site.astro'
import { STRINGS, type Locale } from '../i18n'
import Release from './Release.astro'
import { parseChangelog } from '../lib/changelog'

interface Props { locale: Locale }
const { locale } = Astro.props
const t = STRINGS[locale].changelog
const releases = parseChangelog(changelog)
// The newest versions are open; older ones fold away but stay on the page,
// so search, links to #v0.2.0 and Ctrl+F still find them.
const OPEN = 3
const recent = releases.slice(0, OPEN)
const older = releases.slice(OPEN)
---

<Site locale={locale} path="/changelog/" title={t.title}>
  <div class="page-head wrap narrow">
    <h1 data-reveal>{t.title}</h1>
    <p data-reveal style="--i:1">{t.lead}</p>
  </div>
  <div class="wrap narrow list">
    {recent.map((release) => <Release release={release} locale={locale} open />)}
    {older.length > 0 && <h2 class="older muted" data-reveal>{t.older(older.length)}</h2>}
    {older.map((release) => <Release release={release} locale={locale} />)}
  </div>
</Site>

<script>
  // A link to an older version opens it.
  const open = () => {
    const target = location.hash && document.getElementById(location.hash.slice(1))
    if (target instanceof HTMLDetailsElement) target.open = true
  }
  open()
  addEventListener('hashchange', open)
</script>

<style>
  .narrow { width: min(860px, 100% - 2.5rem); }
  .list { display: grid; gap: 1rem; }
  .older { margin: 2rem 0 0.25rem; font-size: 0.95rem; font-weight: 600; }
</style>
