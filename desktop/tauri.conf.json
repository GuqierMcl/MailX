{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MailX",
  "identifier": "dev.mailx.desktop",
  "build": {
    "beforeDevCommand": "bun run --cwd frontend dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "MailX",
        "width": 1180,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "version": "../package.json"
}
