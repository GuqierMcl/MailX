{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MailX",
  "identifier": "com.mailxapp.desktop",
  "build": {
    "beforeDevCommand": "bun run --cwd frontend dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "MailX",
        "width": 1180,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "capabilities": [
        "main",
        "composer"
      ],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-src mailx-body: http://mailx-body.localhost"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["dmg", "nsis", "deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "本地优先的 AI 原生邮件工作台",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwREUwOEM5RUQ5RUE4RTkKUldUcHFKN3R5UWplc0s3WjdwUGRCNDlXTnFWdjcxQmN4c3UzeXpveVpFeHB2dlRxYWFHVzl3c0EK",
      "endpoints": ["https://github.com/GuqierMcl/MailX/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "version": "../package.json"
}
