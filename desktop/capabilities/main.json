{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allow only the local main window to manage accounts, read cached mail, read and save app settings, manage drafts and the send queue, open composer windows, control its own title bar, and drive the app updater.",
  "windows": ["main"],
  "permissions": ["allow-app-get-startup-status", "allow-app-retry-startup", "allow-accounts-list", "allow-accounts-get", "allow-accounts-create", "allow-accounts-remove", "allow-accounts-update-connection", "allow-accounts-update-profile", "allow-accounts-verify-connection", "allow-accounts-cancel-verification", "allow-accounts-open-provider-help", "allow-folders-list", "allow-emails-list", "allow-emails-get", "allow-emails-fetch-body", "allow-emails-prepare-body", "allow-emails-release-body", "allow-emails-body-links", "allow-links-request", "allow-links-open", "allow-sync-states", "allow-sync-refresh", "allow-emails-set-flag", "allow-attachments-save", "allow-avatars-get", "allow-image-cache-clear", "allow-settings-get", "allow-settings-update", "allow-notifications-test", "allow-notifications-preview-sound", "allow-window-get-chrome", "allow-window-perform", "allow-window-set-theme", "allow-drafts-create", "allow-drafts-create-from", "allow-drafts-list", "allow-drafts-get", "allow-drafts-update", "allow-drafts-delete", "allow-outbox-list", "allow-outbox-get", "allow-outbox-cancel", "allow-outbox-retry-now", "allow-outbox-resolve-unknown", "allow-composer-open", "allow-updater-get-state", "allow-updater-check", "allow-updater-download", "allow-updater-cancel", "allow-updater-restart", "allow-updater-open-link", "core:event:allow-listen", "core:event:allow-unlisten"]
}
