{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "composer",
  "description": "Allow only a local composer window to read settings and accounts, look up recipient suggestions from cached mail, read, save and delete its own draft, attach and detach files through the host (no path crosses the IPC), queue it for sending, ask the built-in AI for writing help on its own draft, close itself, and control its own title bar. No mail, body, link, image or account-management commands.",
  "windows": ["composer-*"],
  "permissions": ["allow-app-menu-update", "allow-app-menu-windows", "allow-app-menu-focus-window", "allow-app-menu-main-action", "allow-accounts-list", "allow-contacts-suggest", "allow-settings-get", "allow-window-get-chrome", "allow-window-perform", "allow-window-set-theme", "allow-drafts-get", "allow-drafts-update", "allow-drafts-delete", "allow-attachments-add", "allow-attachments-add-dropped", "allow-attachments-remove", "allow-attachments-policy", "allow-inline-images-add", "allow-inline-images-add-bytes", "allow-inline-image-preview", "allow-outbox-queue-send", "allow-composer-close", "allow-compose-assist-state", "allow-compose-assist-grant-consent", "allow-compose-assist-start", "allow-compose-assist-cancel", "allow-compose-assist-snapshot", "allow-composer-cancel-close", "core:event:allow-listen", "core:event:allow-unlisten"]
}
