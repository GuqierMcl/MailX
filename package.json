{
  "name": "mailx",
  "version": "0.1.0-alpha.5",
  "private": true,
  "description": "MailX workspace entrypoint",
  "license": "Apache-2.0",
  "repository": "https://github.com/GuqierMcl/MailX.git",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "bun run frontend:dev",
    "frontend:dev": "bun run --cwd frontend dev",
    "frontend:build": "bun run --cwd frontend build",
    "frontend:lint": "bun run --cwd frontend lint",
    "frontend:typecheck": "bun run --cwd frontend typecheck",
    "frontend:test": "bun run --cwd frontend test",
    "frontend:preview": "bun run --cwd frontend preview",
    "build": "bun run frontend:build",
    "lint": "bun run frontend:lint",
    "typecheck": "bun run frontend:typecheck",
    "tauri": "bun scripts/tauri.mjs",
    "desktop:dev": "bun run tauri dev",
    "desktop:build": "bun run tauri build",
    "body-webview:build": "bun scripts/body-webview.mjs build",
    "body-webview:test": "bun scripts/body-webview.mjs run",
    "version:check": "bun scripts/check-version.mjs",
    "version:bump": "bun scripts/bump-version.mjs",
    "version:set": "bun scripts/bump-version.mjs set",
    "version:test": "bun test ./scripts/",
    "release:notes": "bun scripts/release-notes.mjs",
    "release:assets": "bun scripts/release-assets.mjs",
    "types:generate": "bun scripts/generate-types.mjs",
    "types:check": "bun scripts/generate-types.mjs --check",
    "i18n:check": "bun scripts/check-i18n.mjs",
    "icons:generate": "bun scripts/generate-icons.mjs",
    "icons:check": "bun scripts/generate-icons.mjs --check",
    "rust:check": "cargo check --workspace --locked",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "rust:test": "cargo test --workspace --locked",
    "check": "bun run version:check && bun run version:test && bun run i18n:check && bun run types:check && bun run typecheck && bun run lint && bun run frontend:test && bun run build && bun run rust:check"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2"
  }
}
